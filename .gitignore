# Secrets never enter this repository: API keys live in .env (ignored) or the shell environment.
.env
.env.*
!.env.example
*.pem
*.key
# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
# Local data: real evidence packages and questionnaires stay on the machine
data/private/
*.zip
# ...except the fictional sample package the demo and tests use
!samples/*.zip
out/
# Answers an interrupted evaluation saved so far (python -m vea eval resumes from them)
evals/results/.partial-*
# Packaging
build/
dist/
*.egg-info/
# The fictional Sample Co demo signing key: never published (samples/sign_sample.py)
.sample-signing-seed
